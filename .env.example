# Retain the exact image/version of an existing n8n instance unless intentionally upgrading.
# Schema reference used by this repository: n8n 2.40.5.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.40.5
# Frozen synthetic demo date. For today's Berlin date, set DEMO_AS_OF=live.
DEMO_AS_OF=2026-09-23
NOTIFICATION_MODE=dry-run
OLLAMA_ENABLED=false
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
